<h2>📊 Advanced Analytics</h2>

<hr>

<h3>🔥 Top 5 คอนเสิร์ตขายดีที่สุด</h3>
<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; text-align: left;">
    <tr>
        <th>ชื่อคอนเสิร์ต</th>
        <th>ยอดขาย (บาท)</th>
    </tr>
    <% topConcerts.forEach(c => { %>
        <tr>
            <td><%= c.name %></td>
            <td><%= c.total.toLocaleString() %></td>
        </tr>
    <% }) %>
</table>

<hr>

<h3>📈 รายได้รายเดือน</h3>
<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; text-align: left;">
    <tr>
        <th>เดือน</th>
        <th>รายได้ (บาท)</th>
    </tr>
    <% monthlySales.forEach(m => { %>
        <tr>
            <td><%= m.month %></td>
            <td><%= m.total.toLocaleString() %></td>
        </tr>
    <% }) %>
</table>

<hr>

<h3>⏰ ชั่วโมงที่มีการจองมากที่สุด</h3>
<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; text-align: left;">
    <tr>
        <th>เวลา (ชั่วโมง)</th>
        <th>จำนวนการจอง (ครั้ง)</th>
    </tr>
    <% peakHours.forEach(h => { %>
        <tr>
            <td><%= h.hour %>:00</td>
            <td><%= h.total.toLocaleString() %></td>
        </tr>
    <% }) %>
</table>

<hr>

<h3>🎟 Occupancy Rate</h3>
<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; text-align: left;">
    <tr>
        <th>คอนเสิร์ต</th>
        <th>ขายแล้ว (ใบ)</th>
        <th>ที่นั่งทั้งหมด (ใบ)</th>
        <th>% เต็ม</th>
    </tr>
    <% occupancy.forEach(o => { %>
        <tr>
            <td><%= o.name %></td>
            <td><%= o.sold.toLocaleString() %></td>
            <td><%= o.capacity.toLocaleString() %></td>
            <td><%= o.occupancy_rate || 0 %>%</td>
        </tr>
    <% }) %>
</table>